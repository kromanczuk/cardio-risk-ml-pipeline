# Optional overrides for local runs. Copy to .env and fill in. Never commit .env.
GCS_BUCKET=      # defaults to gcs.bucket in config.yaml
MODEL_URI=       # API model: gs://<bucket>/models/<version> or a local folder (default: models/latest)
API_URL=         # UI -> API base URL (default: http://127.0.0.1:8000)
